<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>@ViewBag.Title - Hospital Management</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>

        body {
            margin: 0;
        }

        .sidebar {
            height: 100vh;
            width: 230px;
            position: fixed;
            background: #2c3e50;
            padding-top: 20px;
        }

            .sidebar a {
                display: block;
                color: white;
                padding: 15px;
                text-decoration: none;
                font-size: 18px;
            }

                .sidebar a:hover {
                    background: #1abc9c;
                }

        .main-content {
            margin-left: 230px;
            padding: 20px;
        }

        .sidebar-title {
            color: white;
            text-align: center;
            font-size: 22px;
            margin-bottom: 20px;
        }
    </style>

</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">

        <div class="container-fluid">

            <!-- Logo + Title -->
            <a class="navbar-brand d-flex align-items-center" href="/Home/Index">

                <img src="~/Content/hospitalimagelogo.jpg" width="40" height="40" class="me-2" />

                <span style="font-size:22px;font-weight:bold;">
                    Hospital Management
                </span>

            </a>

            <!-- Mobile button -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Menu -->
            
        </div>

    </nav>

    <!-- Sidebar -->
    <div class="sidebar">

        <div class="sidebar-title">
            Hospital Admin
        </div>

        <a href="/Home/Index">Dashboard</a>

        <a href="/Patient/Index">Patients</a>

        <a href="/Doctor/Index">Doctors</a>

        <a href="/Appointment/Index">Appointments</a>

        <a href="#">Reports</a>

        <a href="#">Logout</a>

    </div>

    <!-- Main Content -->
    <div class="main-content">

        @RenderBody()

    </div>

</body>
</html>