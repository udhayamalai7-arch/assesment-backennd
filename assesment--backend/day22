-- 1. Prevent inserting negative salary
CREATE TRIGGER trg_NoNegativeSalary
ON Employees
FOR INSERT
AS
BEGIN
    IF EXISTS (SELECT 1 FROM inserted WHERE Salary < 0)
        ROLLBACK
END
GO

-- 2. Prevent deleting HR employees
CREATE TRIGGER trg_NoDeleteHR
ON Employees
FOR DELETE
AS
BEGIN
    IF EXISTS (SELECT 1 FROM deleted WHERE Dept = 'HR')
        ROLLBACK
END
GO

-- 3. Auto-increase salary by 10% on update
CREATE TRIGGER trg_SalaryIncrease
ON Employees
AFTER UPDATE
AS
BEGIN
    UPDATE Employees
    SET Salary = Salary * 1.10
    WHERE EmpId IN (SELECT EmpId FROM inserted)
END
GO

-- 4. Prevent updating employee name to NULL
CREATE TRIGGER trg_NoNullName
ON Employees
FOR UPDATE
AS
BEGIN
    IF EXISTS (SELECT 1 FROM inserted WHERE EmpName IS NULL)
        ROLLBACK
END
GO

-- 5. Prevent inserting product with invalid price
CREATE TRIGGER trg_InvalidPrice
ON Products
FOR INSERT
AS
BEGIN
    IF EXISTS (SELECT 1 FROM inserted WHERE Price <= 0)
        ROLLBACK
END
GO

-- 6. Reduce stock automatically on update
CREATE TRIGGER trg_ReduceStock
ON Products
AFTER UPDATE
AS
BEGIN
    UPDATE Products
    SET Stock = Stock - 1
    WHERE ProductId IN (SELECT ProductId FROM inserted)
END
GO

-- 7. Prevent deleting products with stock
CREATE TRIGGER trg_NoDeleteStock
ON Products
FOR DELETE
AS
BEGIN
    IF EXISTS (SELECT 1 FROM deleted WHERE Stock > 0)
        ROLLBACK
END
GO
