        <asp:HyperLink ID="HyperLink3" runat="server" NavigateUrl="~/viewstaff.aspx">VIEW STAFF DETIALS</asp:HyperLink>
        <asp:HyperLink ID="HyperLink4" runat="server" NavigateUrl="~/studentlogin1.aspx">STUDENT VIEW</asp:HyperLink>
