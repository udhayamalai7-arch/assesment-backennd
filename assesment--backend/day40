<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="adminmasterpage.master.cs" Inherits="attendance_management.adminmasterpage" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <style>
     body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background-color: #f4f6f9;
    }
   
      


    /* Header */
    .header {
        background: linear-gradient(to right, #1e3c72, #2a5298);
        padding: 20px;
        text-align: center;
        color: white;
        font-size: 24px;
        font-weight: bold;
        letter-spacing: 1px;
    }

    /* Navbar */
    .navbar {
        display: flex;
        justify-content: center;
        background-color: #1e3c72;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
    }

    .navbar a {
        color: white;
        text-decoration: none;
        padding: 14px 25px;
        display: block;
        font-size: 15px;
        transition: 0.3s;
    }

    .navbar a:hover {
        background-color: #16325c;
        color: #ffd700;
    }

    /* Page Content */
    .main-content {
        padding: 10px;
    }
    /* Center the page content */
.center-wrapper {
    display: flex;
    justify-content: center;   /* horizontal center */
    align-items: center;       /* vertical center */
    height: 50vh;              /* full screen height */
}

/* Login box design */
.login-container {
    width: 350px;
    padding: 30px;
    background-color: white;
    border-radius: 10px;
    box-shadow: 0px 8px 20px rgba(0,0,0,0.2);
}
body{
background: linear-gradient(to right,#74ebd5,#ACB6E5);
font-family: Arial;
}

/* Welcome Section */

.welcome-section{
text-align:center;
padding:40px;
color:#1f3c88;
}

.welcome-section h1{
font-size:40px;
