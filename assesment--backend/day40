}

.title{
    background:#2f4f8f;
    color:white;
    text-align:center;
    padding:15px;
    font-size:28px;
    font-weight:bold;
    letter-spacing:1px;
}

.form-row{
    display:flex;
    margin-top:15px;
}

.form-row label{
    width:150px;
    font-size:18px;
}

.form-row input,
.form-row select{
    width:260px;
    padding:6px;
    border:1px solid #888;
}

.btn{
    margin-top:25px;
    margin-left:150px;
    background:#e91616;
    color:white;
    border:none;
    padding:12px 60px;
    font-size:18px;
    cursor:pointer;
}

.btn:hover{
    background:#c41212;
}

    
   
</style>
</head>
<body>
